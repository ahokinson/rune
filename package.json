{
  "name": "rune-workspace",
  "version": "0.1.0",
  "description": "Workspace for the rune TUI game engine and its example games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahokinson/rune.git"
  },
  "homepage": "https://github.com/ahokinson/rune#readme",
  "bugs": {
    "url": "https://github.com/ahokinson/rune/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "cd packages/rune && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format --write packages examples",
    "lint": "biome lint packages examples",
    "check": "biome check packages examples",
    "cli": "bun ./packages/rune/cli/index.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "example:tomb": "cd examples/tomb && bun run dev",
    "example:attack-surface": "cd examples/attack-surface && bun run dev",
    "example:overworld": "cd examples/overworld && bun run dev",
    "example:tamagotui": "cd examples/tamagotui && bun run dev",
    "example:teapot": "cd examples/teapot && bun run dev",
    "example:git-3d": "cd examples/git-3d && bun run dev"
  },
  "devDependencies": {
    "@ahokinson/rune": "workspace:*",
    "@biomejs/biome": "^2.4.16",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "@types/bun": "latest",
    "solid-js": "^1",
    "typedoc": "^0.28",
    "typedoc-plugin-markdown": "^4",
    "typescript": "^5"
  }
}
